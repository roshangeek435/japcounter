# Canonical base URL for SEO, share links, JSON-LD, react-snap, and sitemap <loc> URLs.
# Required for production builds (prebuild runs generate-sitemap). No trailing slash.
# Until you set this and run `yarn build` or `yarn generate-sitemap`, public/robots.txt + sitemap.xml use https://your-domain.com as a placeholder (not a live domain).
REACT_APP_SITE_URL=https://your-domain.com

# Crawling: true = Allow: / in robots.txt + Sitemap URL; false = Disallow: / (staging, previews).
# Unset defaults to true.
REACT_APP_ALLOW_CRAWL=true

# Optional: override Contact page email if hello@your-domain is not correct.
# REACT_APP_CONTACT_EMAIL=you@your-domain.com

# Sitemap <lastmod> is computed per URL from `git log` on related source files (fallback: file mtime).
# Re-run manually: yarn generate-sitemap  (same as yarn sync-public-seo)

# react-snap (postbuild): runs locally/CI when Chromium is available. On Vercel’s own builder, postbuild skips (VERCEL=1). For prerendered production deploys, use `.github/workflows/deploy-vercel-prerendered.yml` + GitHub Secrets (see workflow comments). To skip snap locally: SKIP_REACT_SNAP=true
